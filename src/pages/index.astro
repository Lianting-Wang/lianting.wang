---
import { profile } from '../data/site';
import { LANGUAGE_KEY, preferredLanguage, localizedUrl } from '../lib/language.mjs';

const root = new URL('/', Astro.site);
const english = new URL('/en/', Astro.site);
const chinese = new URL('/zh/', Astro.site);
const redirectCode = `(() => {
  let saved;
  try { saved = localStorage.getItem(${JSON.stringify(LANGUAGE_KEY)}); } catch {}
  const choose = ${preferredLanguage.toString()};
  const toLocale = ${localizedUrl.toString()};
  const languages = navigator.languages?.length ? navigator.languages : [navigator.language || ''];
  location.replace(toLocale(choose(saved, languages), location.href).href);
})();`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} | Language / 语言</title>
    <meta name="description" content="Choose the English or Chinese version of Lianting Wang's personal website." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={root} />
    <link rel="alternate" hreflang="en" href={english} />
    <link rel="alternate" hreflang="zh-Hans" href={chinese} />
    <link rel="alternate" hreflang="x-default" href={root} />
    <script is:inline set:html={redirectCode} />
    <style>
      :global(body) { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, sans-serif; color: #142b43; background: #f8fafc; }
      main { text-align: center; padding: 2rem; }
      nav { display: flex; justify-content: center; gap: 1.5rem; }
      a { color: #165a9f; }
    </style>
  </head>
  <body>
    <main>
      <h1>{profile.name}</h1>
      <p>Choose a language / 请选择语言</p>
      <nav aria-label="Language / 语言">
        <a href="/en/" lang="en">English</a>
        <a href="/zh/" lang="zh-CN">中文</a>
      </nav>
    </main>
  </body>
</html>
